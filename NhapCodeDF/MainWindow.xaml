<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NhapCodeDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Title="Nhập Code Delta Force">

    <Grid Padding="24" RowSpacing="16" Loaded="Root_Loaded"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hàng 1: Input + nút Nhập -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay}"
                     PlaceholderText="Dán danh sách code, mỗi code một dòng"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     MinHeight="96" MaxHeight="180"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <Button Grid.Column="1"
                    Content="Nhập"
                    Command="{x:Bind ViewModel.ImportCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="140"
                    VerticalAlignment="Stretch"/>
        </Grid>

        <!-- Hàng 2: Bảng code -->
        <controls:DataGrid Grid.Row="1"
                           ItemsSource="{x:Bind ViewModel.Codes}"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserSortColumns="True"
                           CanUserReorderColumns="False"
                           GridLinesVisibility="Horizontal"
                           HeadersVisibility="Column"
                           SelectionMode="Extended">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID"              Binding="{Binding Id}"            Width="80"/>
                <controls:DataGridTextColumn Header="Mã code"         Binding="{Binding Code}"          Width="*"/>
                <controls:DataGridTextColumn Header="Ngày tạo"        Binding="{Binding CreatedAtText}" Width="180"/>
                <controls:DataGridTextColumn Header="Trạng thái nhập" Binding="{Binding StatusText}"    Width="160"/>
                <controls:DataGridTextColumn Header="Mã lỗi"          Binding="{Binding ErrorCode}"     Width="120"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- Hàng 3: thanh trạng thái -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.ExtensionStatusText, Mode=OneWay}"/>

            <ToggleSwitch Grid.Column="2"
                          OnContent="Tự động nhập: Bật" OffContent="Tự động nhập: Tắt"
                          IsOn="{x:Bind ViewModel.IsAutoRunEnabled, Mode=TwoWay}"/>
        </Grid>
    </Grid>
</Window>
